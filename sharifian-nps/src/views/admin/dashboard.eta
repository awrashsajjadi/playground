<% layout('./layout', { title: 'داشبورد', wide: true }) %>
<% const d = it.d, h = it.h, s = d.summary, f = d.filters, o = d.options; %>
<form class="filters card" method="get" action="/admin/dashboard" aria-label="فیلترها">
<label>از روز<select name="from"><option value="">ابتدای کمپین</option><% for (const x of o.days) { %><option value="<%= x.key %>"<%~ f.from === x.key ? ' selected' : '' %>><%= x.label %></option><% } %></select></label>
<label>تا روز<select name="to"><option value="">امروز / پایان</option><% for (const x of o.days) { %><option value="<%= x.key %>"<%~ f.to === x.key ? ' selected' : '' %>><%= x.label %></option><% } %></select></label>
<label>کانال<select name="src"><option value="">همه</option><% for (const x of o.channels) { %><option value="<%= x.key %>"<%~ f.src === x.key ? ' selected' : '' %>><%= x.label %></option><% } %></select></label>
<label>شهر<select name="city"><option value="">همه</option><% for (const x of o.cities) { %><option<%~ f.city === x ? ' selected' : '' %>><%= x %></option><% } %></select></label>
<label>نوع مشتری<select name="type"><option value="">همه</option><% for (const x of o.types) { %><option<%~ f.type === x ? ' selected' : '' %>><%= x %></option><% } %></select></label>
<label>سطح<select name="tier"><option value="">همه</option><% for (const x of o.tiers) { %><option<%~ f.tier === x ? ' selected' : '' %>><%= x %></option><% } %></select></label>
<label>کارشناس<select name="rep"><option value="">همه</option><% for (const x of o.reps) { %><option value="<%= x.key %>"<%~ f.rep === x.key ? ' selected' : '' %>><%= x.label %></option><% } %></select></label>
<label class="check"><input type="checkbox" name="matched" value="1"<%~ f.matchedOnly ? ' checked' : '' %>> فقط مشتریان مچ‌شده</label>
<div class="filter-actions">
<button type="submit" class="btn btn-sm">اعمال</button>
<% if (d.active) { %><a class="btn btn-ghost btn-sm" href="/admin/dashboard">پاک کردن فیلترها</a><% } %>
<a class="btn btn-ghost btn-sm" href="/admin/report<%= d.query ? '?' + d.query : '' %>" target="_blank" rel="noopener">نسخه‌ی چاپی / PDF</a>
</div>
</form>
<p class="refresh muted small"><span>آخرین به‌روزرسانی: <%= d.generatedAt %></span> · <label class="check"><input type="checkbox" id="auto-refresh" checked> به‌روزرسانی خودکار هر ۶۰ ثانیه</label></p>

<section class="kpi-row" aria-label="شاخص‌های اصلی">
<div class="kpi kpi-hero">
<span class="kpi-label">NPS</span>
<strong class="hero" dir="ltr"><%= s.nps === null ? '—' : h.faSigned(s.nps) %></strong>
<span class="kpi-sub"><% if (s.moe !== null) { %>حاشیه‌ی خطا ۹۵٪: <bdi dir="ltr">± <%= h.faNumber(s.moe, 1) %></bdi> · <% } %>n = <%= h.faNumber(s.n) %></span>
</div>
<div class="kpi"><span class="kpi-label">پاسخ‌ها / مشتریان لیست</span><strong class="kpi-value"><%= h.faNumber(s.n) %> <small>از <%= h.faNumber(d.customers) %></small></strong><span class="kpi-sub">نرخ پاسخ (مچ‌شده): <%= d.responseRate === null ? '—' : h.faPercent(d.responseRate) %></span></div>
<div class="kpi"><span class="kpi-label">میانگین امتیاز</span><strong class="kpi-value"><%= s.mean === null ? '—' : h.faNumber(s.mean, 1) %></strong><span class="kpi-sub">از ۱۰</span></div>
<div class="kpi<%= d.todo > 0 ? ' kpi-alert' : '' %>"><span class="kpi-label">منتقدان پیگیری‌نشده</span><strong class="kpi-value"><% if (d.todo > 0) { %><span aria-hidden="true">⚠ </span><% } %><%= h.faNumber(d.todo) %></strong><span class="kpi-sub"><%= d.overdue > 0 ? h.faNumber(d.overdue) + ' مورد بیش از ۴۸ ساعت' : 'همه در مهلت ۴۸ ساعت' %></span></div>
<div class="kpi"><span class="kpi-label">میانه‌ی زمان تکمیل</span><strong class="kpi-value"><%= d.medianSeconds === null ? '—' : h.faNumber(d.medianSeconds) %> <small>ثانیه</small></strong><span class="kpi-sub">هدف: کمتر از ۶۰ ثانیه</span></div>
</section>

<section class="card">
<h2>سهم دسته‌ها</h2>
<%~ include('./_segbar', { s, h, labels: d.chart.labels }) %>
</section>

<div class="grid-2">
<figure class="card chart-card">
<figcaption><h2>توزیع امتیاز ۰ تا ۱۰</h2><ul class="legend"><li><i class="sw sw-detractor"></i>منتقد</li><li><i class="sw sw-passive"></i>خنثی</li><li><i class="sw sw-promoter"></i>مروج</li></ul></figcaption>
<div class="chart-box"><canvas id="ch-hist" role="img" aria-label="تعداد پاسخ برای هر امتیاز از ۰ تا ۱۰"></canvas></div>
<details class="table-view"><summary>جدول داده</summary><table><tr><th>امتیاز</th><% for (const b of d.histogram) { %><th><%= h.fa(b.score) %></th><% } %></tr><tr><th>تعداد</th><% for (const b of d.histogram) { %><td><%= h.faNumber(b.count) %></td><% } %></tr></table></details>
</figure>

<figure class="card chart-card">
<figcaption><h2>روند روزانه</h2><p class="muted small">دو نمودار جدا با یک محور روز؛ محور دوم روی یک نمودار گمراه‌کننده است.</p></figcaption>
<h3 class="chart-sub">NPS تجمعی</h3>
<div class="chart-box chart-box-sm"><canvas id="ch-nps" role="img" aria-label="NPS تجمعی در هر روز"></canvas></div>
<h3 class="chart-sub">تعداد پاسخ در روز</h3>
<div class="chart-box chart-box-sm"><canvas id="ch-daily" role="img" aria-label="تعداد پاسخ در هر روز"></canvas></div>
<details class="table-view"><summary>جدول داده</summary><table><tr><th>روز</th><th>پاسخ</th><th>NPS تجمعی</th></tr><% for (const p of d.trend) { %><tr><td><%= p.label %></td><td><%= h.faNumber(p.count) %></td><td><bdi dir="ltr"><%= p.cumulativeNps === null ? '—' : h.faSigned(p.cumulativeNps) %></bdi></td></tr><% } %></table></details>
</figure>

<section class="card">
<h2>عملکرد کانال‌ها</h2>
<%~ include('./_nps-table', { rows: d.channels, title: 'کانال', h }) %>
</section>

<section class="card">
<h2>قیف تکمیل فرم</h2>
<p class="muted small">فقط فیلتر تاریخ و کانال روی قیف اعمال می‌شود؛ رویدادها داده‌ی مشتری ندارند.</p>
<ol class="funnel">
<% d.funnel.forEach((step, i) => { %><li>
<span class="f-label"><%= step.label %></span>
<span class="f-track" aria-hidden="true"><span class="f-fill" style="width:<%= ((step.ofFirst ?? 0) * 100).toFixed(1) %>%;background:<%= d.chart.colors.funnel[i] %>"></span></span>
<span class="f-count"><%= h.faNumber(step.count) %></span>
<span class="f-note"><%= step.ofFirst === null ? '' : h.faPercent(step.ofFirst) + ' از بازدید' %><% if (step.dropFromPrev !== null) { %> · ریزش <%= h.faPercent(Math.max(0, step.dropFromPrev)) %><% } %></span>
</li><% }) %>
</ol>
</section>
</div>

<h2 class="section-title">چرا؟</h2>
<div class="grid-2">
<figure class="card chart-card">
<figcaption><h2>نقطه‌ی قوت و نقطه‌ی درد</h2><p class="muted small">هر چیپ چند بار توسط مروجان (چپ) و منتقدان (راست) انتخاب شده است.</p><ul class="legend"><li><i class="sw sw-promoter"></i>مروجان — قوت</li><li><i class="sw sw-detractor"></i>منتقدان — درد</li></ul></figcaption>
<div class="chart-box chart-box-tall"><canvas id="ch-drivers" role="img" aria-label="تعداد انتخاب هر عامل توسط مروجان و منتقدان"></canvas></div>
<details class="table-view"><summary>جدول داده</summary><table><tr><th>عامل</th><th>مروج</th><th>خنثی</th><th>منتقد</th></tr><% for (const x of d.drivers) { %><tr><td><%= x.label %></td><td><%= h.faNumber(x.promoters) %></td><td><%= h.faNumber(x.passives) %></td><td><%= h.faNumber(x.detractors) %></td></tr><% } %></table></details>
<div class="highlights">
<div><h3>۳ نقطه‌ی قوت</h3><ol><% for (const x of d.strengths) { %><li><%= x.label %> <span class="muted">— <%= h.faNumber(x.count) %> مروج<% if (x.share !== null) { %> (<%= h.faPercent(x.share) %>)<% } %></span></li><% } %><% if (!d.strengths.length) { %><li class="muted">هنوز داده‌ای نیست</li><% } %></ol></div>
<div><h3>۳ نقطه‌ی درد</h3><ol><% for (const x of d.pains) { %><li><%= x.label %> <span class="muted">— <%= h.faNumber(x.count) %> منتقد و خنثی<% if (x.share !== null) { %> (<%= h.faPercent(x.share) %>)<% } %></span></li><% } %><% if (!d.pains.length) { %><li class="muted">هنوز داده‌ای نیست</li><% } %></ol></div>
</div>
</figure>

<figure class="card chart-card">
<figcaption><h2>موضوع‌های متن نظرها</h2><p class="muted small">برچسب‌گذاری با کلیدواژه‌های <code>config/themes.json</code>.</p><ul class="legend"><li><i class="sw sw-detractor"></i>منتقد</li><li><i class="sw sw-passive"></i>خنثی</li><li><i class="sw sw-promoter"></i>مروج</li></ul></figcaption>
<div class="chart-box chart-box-tall"><canvas id="ch-themes" role="img" aria-label="فراوانی موضوع‌ها به تفکیک دسته"></canvas></div>
<details class="table-view"><summary>جدول داده</summary><table><tr><th>موضوع</th><th>منتقد</th><th>خنثی</th><th>مروج</th><th>جمع</th></tr><% for (const x of d.themes) { %><tr><td><%= x.label %></td><td><%= h.faNumber(x.detractor) %></td><td><%= h.faNumber(x.passive) %></td><td><%= h.faNumber(x.promoter) %></td><td><%= h.faNumber(x.total) %></td></tr><% } %></table></details>
</figure>
</div>

<section class="card">
<h2>NPS به تفکیک سگمنت</h2>
<div class="grid-2 segments">
<% for (const seg of d.segments) { %><div class="segment"><%~ include('./_nps-table', { rows: seg.rows, title: seg.title, h }) %></div>
<% } %></div>
</section>

<section class="card" id="comments">
<div class="wall-head">
<h2>دیوار نظرات <span class="muted small" id="wall-count">(<%= h.faNumber(d.comments.length) %>)</span></h2>
<input type="search" id="wall-search" placeholder="جستجو در متن، نام، شهر…" aria-label="جستجو در نظرها">
<div class="seg-buttons" role="group" aria-label="فیلتر دسته">
<button type="button" data-cat="all" aria-pressed="true">همه</button><button type="button" data-cat="promoter" aria-pressed="false">مروج</button><button type="button" data-cat="passive" aria-pressed="false">خنثی</button><button type="button" data-cat="detractor" aria-pressed="false">منتقد</button>
</div>
</div>
<p class="muted small">ستاره = انتخاب برای ۱۰ نقل‌قول گزارش چاپی. اگر کمتر از ۱۰ ستاره بخورد، بقیه خودکار پر می‌شود.</p>
<ul class="wall">
<% for (const c of d.comments) { %><li class="quote quote-<%= c.category %>" id="q-<%= c.id %>" data-cat="<%= c.category %>" data-search="<%= it.search([c.comment, c.name, c.company, c.city, c.customerType].filter(Boolean).join(' ')) %>">
<div class="quote-head">
<span class="score-badge"><%= h.fa(c.score) %></span>
<span class="cat"><i class="sw sw-<%= c.category %>"></i><%= c.categoryLabel %></span>
<span class="who"><%= c.name ? c.name + (c.company ? ' — ' + c.company : '') : 'مشتری مچ‌نشده' %></span>
<% if (c.city) { %><span class="muted"><%= c.city %></span><% } %>
<time class="muted" datetime="<%= c.createdAt %>" title="<%= c.whenFull %>"><%= c.when %></time>
<form class="star-form" method="post" action="/admin/responses/<%= c.id %>/featured"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="back" value="<%= d.query %>"><input type="hidden" name="featured" value="<%= c.featured ? '0' : '1' %>"><button type="submit" class="star" aria-pressed="<%= c.featured ? 'true' : 'false' %>" title="انتخاب برای گزارش"><span aria-hidden="true"><%= c.featured ? '★' : '☆' %></span><span class="sr-only">منتخب گزارش</span></button></form>
</div>
<p class="quote-text"><%= c.comment %></p>
<% if (c.driverLabels.length || c.themeLabels.length) { %><div class="tags"><% for (const t of c.driverLabels) { %><span class="tag"><%= t %></span><% } %><% for (const t of c.themeLabels) { %><span class="tag tag-theme"># <%= t %></span><% } %></div><% } %>
</li>
<% } %></ul>
<p class="empty" id="wall-empty"<%~ d.comments.length ? ' hidden' : '' %>>نظری پیدا نشد.</p>
</section>

<section class="card" id="followups">
<h2>پیگیری منتقدان (Close the loop) <span class="muted small">— <%= h.faNumber(d.followups.length) %> مورد، <%= h.faNumber(d.todo) %> در انتظار تماس</span></h2>
<p class="muted small">مرتب بر اساس سطح ارزش (اول A) و بعد قدیمی‌ترین. هدف: تماس ظرف ۴۸ ساعت.</p>
<div class="table-wrap">
<table class="followups">
<thead><tr><th>سطح</th><th>مشتری</th><th>موبایل</th><th>امتیاز</th><th>نظر</th><th>کارشناس</th><th>ثبت</th><th>وضعیت</th><th>یادداشت</th><th><span class="sr-only">ذخیره</span></th></tr></thead>
<tbody>
<% for (const r of d.followups) { %><tr id="fu-<%= r.id %>"<%~ r.overdue ? ' class="overdue"' : '' %>>
<td><%= r.tier || '—' %></td>
<td><%= r.name || 'مچ‌نشده' %><% if (r.company || r.city) { %><br><small class="muted"><%= [r.company, r.city].filter(Boolean).join(' · ') %></small><% } %><% if (r.contactOk) { %><br><span class="badge badge-ok">اجازه‌ی تماس دارد</span><% } %></td>
<td><a href="tel:<%= r.mobile %>" dir="ltr"><%= r.mobile %></a></td>
<td class="num"><%= h.fa(r.score) %></td>
<td class="fu-comment"><%= r.comment || '—' %></td>
<td><%= r.repShown || '—' %></td>
<td><%= r.when %><% if (r.overdue) { %><br><span class="badge badge-danger">⚠ بیش از ۴۸ ساعت</span><% } %></td>
<td><select name="status" form="fu-form-<%= r.id %>" aria-label="وضعیت پیگیری"><% for (const st of ['todo', 'called', 'resolved', 'unreachable']) { %><option value="<%= st %>"<%~ r.followupStatus === st ? ' selected' : '' %>><%= { todo: 'در انتظار تماس', called: 'تماس گرفته شد', resolved: 'حل شد', unreachable: 'پاسخ نداد' }[st] %></option><% } %></select></td>
<td><input type="text" name="note" form="fu-form-<%= r.id %>" value="<%= r.followupNote || '' %>" maxlength="1000" aria-label="یادداشت پیگیری"></td>
<td><form id="fu-form-<%= r.id %>" class="fu-form" method="post" action="/admin/responses/<%= r.id %>/followup"><input type="hidden" name="_csrf" value="<%= it.csrf %>"><input type="hidden" name="back" value="<%= d.query %>"><button type="submit" class="btn btn-sm">ذخیره</button></form><small class="fu-meta muted" data-meta><%= r.followupBy ? r.followupBy + ' · ' + h.faDateTime(r.followupAt) : '' %></small></td>
</tr>
<% } %><% if (!d.followups.length) { %><tr><td colspan="10" class="empty">منتقدی در این بازه نیست.</td></tr><% } %>
</tbody>
</table>
</div>
</section>
<script type="application/json" id="dash-data"><%~ h.json(d.chart) %></script>
