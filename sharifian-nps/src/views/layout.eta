<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= it.pageTitle ? it.pageTitle + ' | ' + it.survey.meta.title : it.survey.meta.title %></title>
<meta name="description" content="<%= it.survey.meta.description %>">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#FFFBF5">
<meta name="format-detection" content="telephone=no">
<meta property="og:type" content="website">
<meta property="og:locale" content="fa_IR">
<meta property="og:site_name" content="<%= it.survey.brand.name %>">
<meta property="og:title" content="<%= it.survey.meta.title %>">
<meta property="og:description" content="<%= it.survey.meta.description %>">
<% if (it.h.hasAsset('img/og.png')) { %><meta property="og:image" content="<%= it.baseUrl %><%= it.h.asset('img/og.png') %>">
<% } %><link rel="icon" href="<%= it.h.asset('img/favicon.svg') %>" type="image/svg+xml">
<link rel="preload" href="<%= it.h.asset('fonts/Vazirmatn-NL-Regular.woff2') %>" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="<%= it.h.asset('fonts/Vazirmatn-NL-Bold.woff2') %>" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="<%= it.h.asset('css/form.css') %>">
<% if (it.withScript) { %><script><%~ it.h.inlineScript %></script>
<script defer src="<%= it.h.asset('build/form.js') %>"></script>
<% } %></head>
<body>
<% if (it.test) { %><p class="test-banner" role="status"><%= it.survey.testBanner %></p>
<% } %><header class="brand">
<% if (it.h.hasAsset('img/logo.png')) { %><picture><source type="image/webp" srcset="<%= it.h.asset('img/logo.webp') %>"><img src="<%= it.h.asset('img/logo.png') %>" alt="فروشگاه <%= it.survey.brand.name %>" width="90" height="50"></picture>
<% } else { %><span class="brand-mark"><%= it.survey.brand.name %></span>
<% } %></header>
<main id="main" class="page">
<%~ it.body %>
</main>
</body>
</html>
